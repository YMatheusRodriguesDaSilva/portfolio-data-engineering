# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.python-version

# Data / local DB
*.db
*.sqlite
*.sqlite3
.DS_Store

# Keep sample schema; ignore heavy regenerated dumps if needed
# data/raw and processed are generated by scripts — ignore local runs
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

# Streamlit / IDE
.streamlit/secrets.toml
.idea/
.vscode/
*.log
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
